{
  "name": "javierleon9966/alias",
  "description": "Detects players possible alternatives accounts",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "phpstan": "@php vendor/bin/phpstan",
    "make-queries": "@php vendor/bin/fx.php src JavierLeon9966\\\\Alias\\\\RawQueries --sql resources --struct \"final class\" --prefix alias"
  },
  "require": {
    "pocketmine/pocketmine-mp": "^5.0.0",
    "sof3/libasynql": "^4.2.0",
    "sylvrs/libmarshal": "^1.4.3",
    "sof3/await-generator": "dev-add-phpdocs as 3.6.2",
    "sof3/pmevent": "^0.0.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/extension-installer": "^1.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/javierleon9966/await-generator"
    }
  ],
  "autoload": {
    "psr-0": {
      "JavierLeon9966\\Alias\\": "src"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
